APP_ENV=development

DATABASE_URL=postgresql://nexusai:replace_with_postgres_password@127.0.0.1:5433/nexusai
POSTGRES_DB=nexusai
POSTGRES_USER=nexusai
POSTGRES_PASSWORD=replace_with_postgres_password

# 运行保护
AGENT_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_OUTPUT_CHARS=100000
AGENT_RUN_TIMEOUT_SECONDS=180
CONVERSATION_TITLE_TIMEOUT_SECONDS=8
SSE_HEARTBEAT_SECONDS=15
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=3
SNOWFLAKE_WORKER_ID=0

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# 劳动法律 RAG Embedding
LEGAL_EMBEDDING_BASE_URL=https://tokenhub.tencentmaas.com/v1
LEGAL_EMBEDDING_MODEL=kinfra-text-embedding-0.6b
LEGAL_EMBEDDING_TIMEOUT_SECONDS=60
LEGAL_EMBEDDING_MAX_RETRIES=2
LEGAL_RAG_TOP_K=8
LEGAL_RAG_CANDIDATE_COUNT=30
LEGAL_RAG_MIN_SIMILARITY=0.32
LEGAL_RAG_MAX_CONTEXT_CHARS=24000

# OpenAlex 文献检索
OPENALEX_API_KEY=
OPENALEX_TIMEOUT_SECONDS=20
OPENALEX_MAX_RETRIES=2
OPENALEX_RETRY_DELAY_SECONDS=0.5
RESEARCH_MAX_SEARCH_ROUNDS=3

# TokenHub API Key
TENCENT_TOKENHUB_API_KEY=
TENCENT_TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com
TENCENT_HY_IMAGE_MODEL=hy-image-v3.5-preview
TENCENT_HY_IMAGE_ENDPOINT=/v1/wand/hunyuan-image/v35-generation
TENCENT_TOKENHUB_TIMEOUT_SECONDS=180
# 单张参考图片上传上限，最多 5 MiB。
IMAGE_UPLOAD_MAX_BYTES=5242880
IMAGE_RESULT_MAX_BYTES=52428800

# 阿里云 OSS
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_OBJECT_PREFIX=nexusai

# 文献解读助手
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
LITERATURE_WORKER_SNOWFLAKE_ID=1
AGENT_WORKER_SNOWFLAKE_ID=2
AGENT_EVENT_MAX_LENGTH=2000
AGENT_EVENT_TTL_SECONDS=86400
AGENT_EVENT_REDIS_TIMEOUT_SECONDS=5
LITERATURE_UPLOAD_MAX_BYTES=31457280
LITERATURE_MAX_PAGES=400
LITERATURE_CHUNK_MAX_CHARS=1200
LITERATURE_CONTEXT_MAX_CHARS=24000
LITERATURE_TOP_K=8
LITERATURE_CANDIDATE_COUNT=30
LITERATURE_MIN_SIMILARITY=0.32

# 火山引擎方舟
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915

# 实习僧职位搜索
SHIXISENG_APP_ID=
SHIXISENG_APP_SECRET=
SHIXISENG_BASE_URL=https://open.shixiseng.com

# QQ 邮箱 SMTP
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_NAME=NexusAI
# 用随机长密钥保护低熵邮箱验证码摘要；生产环境务必单独设置并保管。
AUTH_CODE_PEPPER=
# 验证码及会话使用 CELERY_BROKER_URL 指向的 Redis TTL 键。
AUTH_COOKIE_NAME=nexusai_session
AUTH_SESSION_TTL_SECONDS=604800

# Stripe Checkout 沙盒配置。必须使用 sk_test_ 与对应 Webhook 的 whsec_ 密钥。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout 成功/取消后返回的前端 origin；生产或测试部署时按实际地址设置。
STRIPE_TOPUP_RETURN_BASE_URL=http://localhost:5173
# 只列出已在当前 Stripe 沙盒账户验证过的币种及充值金额上下限（整数主单位）。
STRIPE_TOPUP_CURRENCY_LIMITS={"usd":{"min":1,"max":999999},"eur":{"min":1,"max":999999},"jpy":{"min":50,"max":999999}}
