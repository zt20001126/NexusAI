APP_ENV=development

CHECKPOINT_BACKEND=postgres
# 本地直接运行后端时使用 localhost；账号密码需与下方 POSTGRES_* 一致
DATABASE_URL=postgresql://nexusai:replace_with_postgres_password@localhost:5432/nexusai
POSTGRES_DB=nexusai
POSTGRES_USER=nexusai
POSTGRES_PASSWORD=replace_with_postgres_password

# 运行保护
AGENT_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_OUTPUT_CHARS=100000
AGENT_RUN_TIMEOUT_SECONDS=180
SSE_HEARTBEAT_SECONDS=15

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# 腾讯混元生图极速版
TENCENT_TOKENHUB_API_KEY=
TENCENT_TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com
TENCENT_HY_IMAGE_MODEL=hy-image-v3.5-preview
TENCENT_HY_IMAGE_ENDPOINT=/v1/wand/hunyuan-image/v35-generation

# 火山引擎方舟
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915
