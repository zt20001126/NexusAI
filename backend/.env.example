# 应用
APP_ENV=development

# DeepSeek（OpenAI-compatible API）
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# 腾讯混元生图极速版（TextToImageLite，腾讯云 CAM 凭证）
TENCENT_CLOUD_SECRET_ID=replace_with_tencent_cloud_secret_id
TENCENT_CLOUD_SECRET_KEY=replace_with_tencent_cloud_secret_key
TENCENT_HUNYUAN_IMAGE_REGION=ap-guangzhou
TENCENT_HUNYUAN_IMAGE_ENDPOINT=https://aiart.tencentcloudapi.com
TENCENT_HUNYUAN_IMAGE_API_VERSION=2022-12-29
TENCENT_HUNYUAN_IMAGE_ACTION=TextToImageLite

# 火山引擎方舟 Seedream 5.0 Flash
VOLCENGINE_ARK_API_KEY=replace_with_volcengine_ark_api_key
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915

# 数据库：当前运行时仍使用内存 Checkpoint，PostgreSQL 适配器尚未接入
CHECKPOINT_BACKEND=memory
DATABASE_URL=postgresql+psycopg://replace_with_db_user:replace_with_db_password@localhost:5432/nexusai

# 运行保护
AGENT_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_OUTPUT_CHARS=100000
AGENT_RUN_TIMEOUT_SECONDS=180
SSE_HEARTBEAT_SECONDS=15
