# 应用
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# 模型：示例智能体无需模型即可运行；开发真实业务智能体时再填写
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# 默认内存模式不依赖 PostgreSQL
CHECKPOINT_BACKEND=memory
DATABASE_URL=

# 默认内存模式不依赖 Redis
LOCK_BACKEND=memory
EVENT_BUS_BACKEND=memory
REDIS_URL=

# 默认禁用异步任务
TASK_BACKEND=disabled
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# 运行保护
AGENT_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_OUTPUT_CHARS=100000
AGENT_RUN_TIMEOUT_SECONDS=180
SSE_HEARTBEAT_SECONDS=15
